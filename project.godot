; Engine configuration file.
; 《星丘残响》Hoshigaoka Echoes — Phase 0 工程骨架
; 严格遵循 V2.1.4 CLEAN MASTER（L1 锁定技术栈 / L2 目录 / L4 Autoload / L6 存档 / L9 导出）
; 引擎：Godot 4.7.2 Stable ｜ 渲染：Compatibility / OpenGL ｜ 2D 像素项目

config_version=5

[application]

config/name="HoshigaokaEchoes"
config/description="星丘残响 — 日系校园像素风角色构筑塔防 RPG"
config/version="0.1.0-phase0"
run/main_scene="res://scenes/bootstrap/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
; 单玩家档案，无需多开
config/quit_on_go_back=true
; L6：开启自定义用户目录，正式数据目录 %APPDATA%\HoshigaokaEchoes
config/use_custom_user_dir=true
config/custom_user_dir_name="HoshigaokaEchoes"

[autoload]

; L4：App / DataRegistry / SaveService / AudioService / SceneRouter
; 说明：Logger 以类（class_name）形式提供，不占用 Autoload 槽位；
; BattleSession / StageRuntime / StoryRunner 按 L4 要求场景实例化，不进全局单例。
App="*res://scripts/app/app.gd"
DataRegistry="*res://scripts/data/data_registry.gd"
SaveService="*res://scripts/save/save_service.gd"
AudioService="*res://scripts/services/audio_service.gd"
SceneRouter="*res://scripts/app/scene_router.gd"

[display]

; J1：设计分辨率 1920×1080，最低验证 1280×720；16:9 主基线
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"


[rendering]

; 2D 像素项目：纹理默认最近邻过滤（J9.7）
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.055, 0.063, 0.098, 1)

[physics]

common/physics_ticks_per_second=60

[gui]

theme/default_font_multichannel_signed_distance_field=true
