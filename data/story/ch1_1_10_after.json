  "nodes": [
    {
      "id": "0",
      "speaker": "",
      "character": "",
      "text": "红色圆环停止转动。试卷落在地上，没有燃烧，也没有碎裂。"
    },
    {
      "id": "1",
      "speaker": "无名优等生",
      "character": "",
      "text": "如果……不是第一……"
    },
    {
      "id": "2",
      "speaker": "雨宫澪",
      "character": "amamiya_mio",
      "text": "也可以留下。"
    },
    {
      "id": "3",
      "speaker": "",
      "character": "",
      "text": "层层成绩单之间，显出一个普通学生的剪影。没有名次，也没有奖状。",
      "background": "bg_env_chapter_one_coda"
    },
    {
      "id": "4",
      "speaker": "小川结衣",
      "character": "ogawa_yui",
      "text": "可以休息了。今天已经做得够多了。"
    },
    {
      "id": "5",
      "speaker": "水濑纱良",
      "character": "minase_sara",
      "text": "频率正在降低。不是归零……是重新分开，回到每个人身上。"
    },
    {
      "id": "6",
      "speaker": "藤原凛",
      "character": "fujiwara_rin",
      "text": "调查结束。全员返回。"
    },
    {
      "id": "7",
      "speaker": "白石千夏",
      "character": "shiraishi_chinatsu",
      "text": "我听见啦！你们每个人的声音，我都听见了。"
    },
    {
      "id": "8",
      "speaker": "神谷悠真",
      "character": "kamiya_yuma",
      "text": "那下次社团活动，也给你留个位子。"
    },
    {
      "id": "9",
      "speaker": "白石千夏",
      "character": "shiraishi_chinatsu",
      "text": "说好了。不要把我当作只有热闹的时候才需要的人。"
    },
    {
      "id": "10",
      "speaker": "{player}",
      "character": "",
      "text": "欢迎加入，千夏。"
    },
    {
      "id": "11",
      "speaker": "",
      "character": "",
      "text": "晨光穿过体育馆的高窗。走廊里，新一届文化祭的海报轻轻晃动。"
    },
    {
      "id": "12",
      "speaker": "",
      "character": "",
      "text": "学生手册多出一页夹纸。背面只有一句话：你听见的，真的都是今天的声音吗？"
    },
    {
      "id": "13",
      "speaker": "",
      "character": "",
      "text": "第一章 · 新学期的残响　完。\n放课后观测会的记录，还将继续。"
    }
  ]
}
