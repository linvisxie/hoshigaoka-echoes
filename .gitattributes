# 统一换行与文本处理规则
# 避免 Git 在 Windows 上反复提示 LF/CRLF 转换

* text=auto

# GDScript / 配置 / 文档统一 LF（Godot 与 Git 均友好）
*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.json  text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.godot text eol=lf

# 二进制资产不做换行处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ogg   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.pck   binary
*.zip   binary
*.tpz   binary
